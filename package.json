{
  "name": "izmir-ag-haritasi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "cross-env NODE_ENV=production node server/index.ts",
    "data:network": "node scripts/build-network.mjs",
    "typecheck": "tsc -b",
    "data:transit": "node scripts/build-transit.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "@tanstack/react-query": "^5.90.0",
    "cross-env": "^10.0.0",
    "hono": "^4.10.0",
    "leaflet": "^1.9.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.0",
    "fflate": "^0.8.3",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
